{
  "name": "@linguabridge/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "ai:check": "tsx src/scripts/aiCheck.ts",
    "translate:check": "tsx src/scripts/translateCheck.ts",
    "test": "tsx --test src/tests/unit.test.ts src/tests/checks.test.ts",
    "assist:check": "tsx src/scripts/assistCheck.ts",
    "translate:matrix": "tsx src/scripts/translateMatrix.ts"
  },
  "dependencies": {
    "@linguabridge/shared": "*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
